{
  "name": "chess-games-history",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build-openings": "node scripts/build-openings.mjs",
    "prebuild": "node scripts/build-openings.mjs",
    "dev": "next dev --turbopack",
    "build": "next build",
    "prebuild:export": "node scripts/build-openings.mjs",
    "build:export": "NEXT_EXPORT=1 next build",
    "start": "next start",
    "lint": "eslint .",
    "test": "npm run test:unit && npm run test:e2e",
    "test:unit": "TZ=UTC vitest run",
    "test:unit:watch": "TZ=UTC vitest",
    "test:e2e": "playwright test",
    "test:health": "playwright test --config=playwright.health.config.ts",
    "deploy:dev": "bash scripts/deploy.sh dev",
    "deploy:prod": "bash scripts/deploy.sh prod",
    "cdk:bootstrap": "cd infra && npm install --prefer-offline --silent && npx cdk bootstrap"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.89.0",
    "@tanstack/react-virtual": "^3.13.23",
    "chess.js": "^1.4.0",
    "next": "^16.2.2",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-markdown": "^10.1.0"
  },
  "devDependencies": {
    "@aws-sdk/client-dynamodb": "^3.658.0",
    "@aws-sdk/client-lambda": "^3.658.0",
    "@aws-sdk/client-s3": "^3.658.0",
    "@aws-sdk/lib-dynamodb": "^3.658.0",
    "@playwright/test": "^1.49.1",
    "@types/aws-lambda": "^8.10.145",
    "@types/node": "^22.15.3",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "eslint": "^9.39.4",
    "eslint-config-next": "^16.2.2",
    "postcss": "^8.5.3",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.8.3",
    "vitest": "^2.1.8"
  }
}
