{
  "name": "chess-games-history",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build-openings": "node scripts/build-openings.mjs",
    "prebuild": "node scripts/build-openings.mjs",
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview --port 3000",
    "lint": "eslint .",
    "test": "npm run test:unit && npm run test:e2e",
    "test:unit": "TZ=UTC vitest run",
    "test:unit:watch": "TZ=UTC vitest",
    "test:e2e": "playwright test",
    "test:health": "playwright test --config=playwright.health.config.ts",
    "deploy:dev": "bash scripts/deploy.sh dev",
    "deploy:prod": "bash scripts/deploy.sh prod",
    "cdk:bootstrap": "cd infra && npm install --prefer-offline --silent && npx cdk bootstrap"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.124.0",
    "@aws-sdk/client-secrets-manager": "^3.1128.0",
    "@tanstack/react-virtual": "^3.13.23",
    "chess.js": "^1.4.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.1.1"
  },
  "devDependencies": {
    "@aws-sdk/client-dynamodb": "^3.658.0",
    "@aws-sdk/client-lambda": "^3.658.0",
    "@aws-sdk/client-s3": "^3.658.0",
    "@aws-sdk/lib-dynamodb": "^3.658.0",
    "@eslint/js": "^9.39.4",
    "@playwright/test": "^1.49.1",
    "@types/aws-lambda": "^8.10.163",
    "@types/node": "^22.15.3",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.16",
    "globals": "^15.14.0",
    "postcss": "^8.5.3",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.20.0",
    "vite": "^6.0.7",
    "vitest": "^2.1.8"
  }
}
