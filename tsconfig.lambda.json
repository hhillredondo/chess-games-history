{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"]
    },
    "module": "commonjs",
    "moduleResolution": "node",
    "lib": ["esnext"],
    "target": "ES2020",
    "noEmit": false
  },
  "include": ["src/lambda/**/*", "src/lib/**/*"]
}
